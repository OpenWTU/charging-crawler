# 本机部署配置（不入仓库；.gitignore 已排除 deploy.local.ps1）
#
# 复制本文件为 deploy.local.ps1 并填入你自己的值：
#   $cfgHost = 'root@1.2.3.4'                       # SSH 目标
#   $cfgSshKey = "$env:USERPROFILE\.ssh\my_deploy"    # SSH 私钥
#   $cfgNode = 'C:\path\to\node.exe'                # 可选：不在 PATH 时填绝对路径
#   $cfgPnpm = 'C:\path\to\pnpm.cjs'                # 可选
#   $cfgPy   = 'C:\path\to\python.exe'              # 可选（缺省用 python）
#
# 也可以不建文件，改用环境变量：CHARGE_DEPLOY_HOST / CHARGE_DEPLOY_KEY /
# CHARGE_DEPLOY_NODE / CHARGE_DEPLOY_PNPM / CHARGE_DEPLOY_PY
