<?xml version="1.0" encoding="utf-8"?>
<!--
  S4 修复：原来 AndroidManifest 里 usesCleartextTraffic="true" 全局放行明文。

  后果：Cloud.java 上传体里带 rawToken、注册体带 device_secret、ApiClient 每次带
  Authorization: Bearer <JWT> —— 在公共 Wi-Fi / 校园网下等于把这些交给同网段任何人。

  现在的策略：
  - 默认 **禁止** 明文（base-config）
  - 只对「已知的、部署在裸 IP 上的备用节点」显式放行
  - 主域名 charge.lizishuo.cn 走 HTTPS（不在放行列表里）

  ⚠️ 新增一个 http 备用节点时，必须在这里补 <domain>，否则 App 连不上它。
  （networkSecurityConfig 不支持 CIDR 网段，只能逐个列主机名/IP）
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 备用节点（无域名、只有裸 IP，只能用 http） -->
        <domain includeSubdomains="false">141.11.148.175</domain>
        <!-- 局域网零配置 / 本地调试 -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
