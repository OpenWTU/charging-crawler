{
  "name": "charge-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校园充电桩空位查询 —— Node/TypeScript 后端（Python 版的重写）",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:dry": "tsx src/db/migrate-cli.ts --dry-run"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@libp2p/bootstrap": "^11.0.47",
    "@libp2p/crypto": "^5.2.0",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/interface": "^2.11.0",
    "@libp2p/mdns": "^11.0.47",
    "@libp2p/tcp": "^10.1.19",
    "@multiformats/multiaddr": "^12.4.4",
    "fastify": "^5.2.1",
    "kysely": "^0.28.0",
    "libp2p": "^2.10.0",
    "pino": "^9.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
