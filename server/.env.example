# ---- 服务 ----
HOST=0.0.0.0
PORT=8791
LOG_LEVEL=info
NODE_ENV=production

# ---- 数据库 ----
# 双跑期建议设为 true，只读打开生产库（避免与 Python 抢写锁）
DATABASE_READONLY=false
DATABASE_PATH=./data/charge.db

# ---- 静态资源 ----
# 指向前端构建产物（Vite 输出目录）
WEB_DIST=../webui/dist
APK_DIR=../data/download

# ---- 安全 ----
# 与 Python 版共用同一个令牌主密钥文件（绝不能提交到仓库）
TOKEN_KEY_FILE=/var/lib/charge-cloud/token_key

# ---- P2P（默认关闭；开启会多占约 100MB 内存） ----
P2P_ENABLED=false
P2P_LISTEN_PORT=4001
# 多个引导节点用逗号分隔，例如：/ip4/1.2.3.4/tcp/4001/p2p/12D3Koo...
P2P_BOOTSTRAP=

# ---- 分析时区 ----
ANALYTICS_TZ=Asia/Shanghai
