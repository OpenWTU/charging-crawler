[Unit]
Description=Charge pile cloud (snapshot upload + update)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/charge-cloud
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 -m cloud.app --host 127.0.0.1 --port 8788 --db /var/lib/charge-cloud/charge.db --secret-file /etc/charge-cloud/upload_secret.txt --version-file /var/lib/charge-cloud/version.json --download-dir /var/lib/charge-cloud/download
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/charge-cloud

[Install]
WantedBy=multi-user.target
